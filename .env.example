# HuggingFace access token — required to download Qwen3-8B.
# 1. Accept the model license at https://huggingface.co/Qwen/Qwen3-8B
# 2. Create a token at https://huggingface.co/settings/tokens
# 3. Copy this file to .env and fill in your token, OR set the variable
#    directly in your shell before running:
#
#      Windows PowerShell:  $env:HF_TOKEN = "hf_..."
#      Linux / macOS:       export HF_TOKEN="hf_..."

HF_TOKEN=hf_your_token_here
